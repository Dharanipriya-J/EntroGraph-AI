# Copy to .env (never commit .env). Defaults work with the Docker Compose file.
FALKORDB_MODE=server            # server (Docker/self-hosted/FalkorDB Cloud) | embedded (falkordblite, no Docker)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=              # set if your FalkorDB requires one
FALKORDB_EMBEDDED_PATH=./data/entrograph.rdb   # only for FALKORDB_MODE=embedded
GRAPH_NAME=entrograph
AUTO_LOAD_SCENARIO=true         # load the synthetic scenario on first start when the graph is empty
RISK_CONFIG_PATH=               # optional JSON file overriding RiskConfig defaults
# Optional LLM text layer (default is the labelled deterministic mode). The LLM only rewrites a summary; it never writes Cypher or changes scores.
ENTROGRAPH_LLM=deterministic    # deterministic | anthropic
ENTROGRAPH_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
